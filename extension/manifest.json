{
  "manifest_version": 3,
  "name": "B站社交圈",
  "version": "0.1.0",
  "description": "看清你在 B站 的社交圈：关注关系图、粉丝、谁给你转发评论、私信统计。数据只存在本机。",
  "homepage_url": "https://github.com/PathGao/BiliSocial",
  "permissions": ["storage", "unlimitedStorage", "cookies", "alarms", "scripting"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://search.bilibili.com/*",
    "https://t.bilibili.com/*",
    "https://api.vc.bilibili.com/*",
    "https://*.hdslb.com/*"
  ],
  "content_scripts": [{ "matches": ["https://www.bilibili.com/*", "https://search.bilibili.com/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*"], "js": ["content/badges.js"], "run_at": "document_idle" },
    { "matches": ["https://www.bilibili.com/video/*"], "js": ["content/viewer-frame.js"], "css": ["content/viewer-frame.css"], "all_frames": true, "run_at": "document_start" }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "B站社交圈",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
